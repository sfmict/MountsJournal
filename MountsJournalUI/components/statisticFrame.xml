<Ui xmlns="http://www.blizzard.com/wow/ui/">
	<Button name="MJMountStatisticListButtonTemplate" virtual="true">
		<Size y="40"/>
		<Layers>
			<Layer level="BACKGROUND">
				<Texture atlas="PetList-ButtonBackground" parentKey="background"/>
			</Layer>
			<Layer level="ARTWORK">
				<Texture parentKey="stat">
					<Anchors>
						<Anchor point="TOPLEFT" x="3" y="-3"/>
						<Anchor point="BOTTOMLEFT" x="3" y="3"/>
					</Anchors>
					<Color r=".3" g=".6" b=".3" a=".15"/>
				</Texture>
			</Layer>
			<Layer level="OVERLAY">
				<FontString parentKey="value" inherits="GameFontNormal" justifyH="RIGHT" wordwrap="false">
					<Anchors>
						<Anchor point="RIGHT" x="-6" y="1"/>
					</Anchors>
				</FontString>
				<FontString parentKey="name" inherits="GameFontNormal" justifyH="LEFT" maxLines="2">
					<Anchors>
						<Anchor point="LEFT" x="6" y="1"/>
						<Anchor point="RIGHT" relativeKey="$parent.value" relativePoint="LEFT" x="-5"/>
					</Anchors>
				</FontString>
			</Layer>
		</Layers>
		<HighlightTexture parentKey="highlight" atlas="PetList-ButtonHighlight"/>
		<Frames>
			<Button parentKey="dragButton" inherits="MJMountDragButtonTemplate"/>
		</Frames>
	</Button>
</Ui>